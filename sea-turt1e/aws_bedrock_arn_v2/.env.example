# Dify Plugin Environment Configuration
# Copy this file to .env.local and update with your actual values

# Dify API Configuration (for plugin development)
# DIFY_API_KEY=your_actual_api_key_here
# DIFY_HOST=localhost
# DIFY_PORT=5001

# Plugin Configuration
MAX_REQUEST_TIMEOUT=120

# Development Mode
# Uncomment the following for local development without Dify connection
# PLUGIN_DEV_MODE=true

# AWS Configuration (for testing)
# AWS_ACCESS_KEY_ID=your_aws_access_key_id
# AWS_SECRET_ACCESS_KEY=your_aws_secret_access_key
# AWS_DEFAULT_REGION=us-east-1
